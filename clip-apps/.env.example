# Copy to `.env.development` / `.env.local` and adjust (Vite exposes only `VITE_*` to client).

# Kiri CAM legacy — tree: `src/core/cam/legacy/kiri/...` (`kiriCamRuntime` / `camEngine`).
# Bundled via `kiriCamLegacyBootstrap` (static import). `0` = off, `1` = strict, `auto` = try then placeholder.
# VITE_KIRI_LEGACY_CAM=1

# Kiri FDM legacy — tree: `src/core/slicer/legacy/kiri/...` (`slicer.worker` / `kiriEngine`).
# Bundled via `kiriLegacyFdmBootstrap`. Same semantics as CAM. Prefer `1` for desktop production.
# VITE_KIRI_LEGACY_FDM=1

# Main-thread legacy slice timeout (ms), clamped 100..300000
# VITE_KIRI_LEGACY_SLICE_TIMEOUT_MS=30000

# Raster grip-path-main bridge (planar/radial); sync STLs: npm run sync:grip-fixtures
# VITE_RASTER_GRIP_BRIDGE=1

# Optional footer on MigrationProgressBar in dev
# VITE_MIGRATION_GATE_LABEL=gate ok
