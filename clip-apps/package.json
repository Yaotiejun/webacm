{
  "name": "clip-apps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:migration": "vitest run --config vitest.migration.ts",
    "test:cam": "vitest run --config vitest.migration.ts src/core/cam src/stores/useCamStore.spec.ts src/api/cam.spec.ts",
    "test:raster": "vitest run --config vitest.migration.ts src/core/raster src/api/raster.spec.ts",
    "capture:cam-fixture": "vitest run --config vitest.capture.ts",
    "migration:progress": "vitest run src/core/migration/migrationProgressScoreboard.spec.ts",
    "migration:report": "node scripts/print-migration-progress.mjs",
    "sync:grip-fixtures": "node scripts/sync-grip-raster-fixtures.mjs",
    "sync:grip-wasm": "node scripts/sync-grip-wasm.mjs",
    "sync:grip-kiri-shared": "node scripts/sync-grip-kiri-shared.mjs",
    "sync:grip-kiri-ext": "node scripts/sync-grip-kiri-ext.mjs",
    "sync:grip-carvera-assets": "node scripts/sync-grip-carvera-assets.mjs",
    "sync:kiri-devices": "node scripts/sync-kiri-devices.mjs",
    "sync:grip-all": "node scripts/sync-grip-all.mjs",
    "sync:verify": "node scripts/sync-and-verify.mjs",
    "check:raster-baseline": "vitest run src/core/raster/rasterGripBaselineLoader.integration.spec.ts src/core/raster/rasterGripBaselineMeta.spec.ts src/core/raster/rasterGripRadialBaselineMeta.spec.ts src/core/raster/rasterGripBaselineMeta.fixture.spec.ts src/core/raster/rasterGripBaselineShape.spec.ts",
    "golden:raster": "npm run check:raster-baseline && vitest run --config vitest.golden.ts",
    "golden:raster:stl-trace": "vitest run src/core/raster/rasterGripStlTracing.live.spec.ts",
    "soak:carvera": "vitest run src/core/devices/carveraProductionSoak.live.spec.ts",
    "soak:texturizer": "vitest run src/core/texturizer/texturizerMigrationSoak.spec.ts",
    "soak:texturizer:live": "vitest run src/core/texturizer/texturizerLiveMesh.live.spec.ts",
    "soak:gridbot": "vitest run src/core/devices/gridbotProductionSoak.live.spec.ts",
    "soak:offline": "npm run soak:texturizer && vitest run src/core/migration/migrationProductGates.spec.ts src/core/bootstrap/bootstrapMigrationComplete.spec.ts src/core/migration/deviceBridgeMigrationComplete.spec.ts src/core/migration/backendMigrationComplete.spec.ts src/core/cam/camMigrationComplete.spec.ts src/core/slicer/fdmMigrationComplete.spec.ts src/core/fdm/fdmSupportPaint.spec.ts src/core/fdm/fdmSupportPaintMigrationComplete.spec.ts src/core/devices/carveraMigrationComplete.spec.ts src/core/devices/gridbotMigrationComplete.spec.ts src/core/texturizer/texturizerMigrationComplete.spec.ts src/core/raster/rasterMigrationComplete.spec.ts src/core/laser/laserMigrationComplete.spec.ts src/core/sla/slaMigrationComplete.spec.ts && npm run soak:laser && npm run soak:sla",
    "migration:gates": "vitest run src/core/migration/migrationProductGates.spec.ts",
    "test:cam:legacy-export": "vitest run src/core/cam/camEngine.legacy.exportStream.live.spec.ts",
    "soak:cam:live": "vitest run src/core/cam/camEngine.legacy.exportStream.live.spec.ts",
    "soak:devices:live": "vitest run src/core/devices/carveraProductionSoak.live.spec.ts src/core/devices/gridbotProductionSoak.live.spec.ts",
    "soak:device-bridge:mock": "node scripts/device-bridge-mock-soak.mjs",
    "soak:fdm:live": "vitest run src/core/slicer/fdmLiveMigration.live.spec.ts",
    "soak:fdm:dual-extruder": "vitest run src/core/slicer/fdmDualExtruderPurge.soak.spec.ts src/core/slicer/fdmDualExtruderPurge.integration.spec.ts",
    "test:fdm:dual-extruder": "vitest run src/core/slicer/fdmDualExtruderPurge.integration.spec.ts src/core/slicer/fdmGcodeNormalize.spec.ts",
    "test:fdm:support-paint": "vitest run src/core/slicer/fdmSupportPaint.integration.spec.ts src/core/fdm/fdmSupportPaint.spec.ts",
    "test:cam:animate-mesh": "vitest run src/core/cam/camAnimateMeshScene.spec.ts src/core/cam/camAnimateBridge.spec.ts",
    "test:cam:animate": "vitest run src/core/cam/camAnimateBridge.spec.ts",
    "migration:ordered-soak": "node scripts/migration-ordered-soak.mjs",
    "migration:ordered:offline": "npx vitest run src/core/migration/migrationOrderedPipeline.spec.ts src/core/cam/camLiveExportMigration.spec.ts src/core/devices/deviceProductionSoakMigration.spec.ts src/core/slicer/fdmLegacyMigrationComplete.spec.ts src/core/raster/rasterE2eMigrationComplete.spec.ts src/core/laser/laserSoakMigrationComplete.spec.ts src/core/sla/slaSoakMigrationComplete.spec.ts --config vitest.migration.ts",
    "migration:verify": "npm run check:raster-baseline && npm run test:migration",
    "migration:ci": "node scripts/ci-migration.mjs",
    "migration:quickstart": "node scripts/migration-quickstart.mjs",
    "test:e2e:migration": "playwright test e2e/migration-workspaces.spec.ts e2e/raster-grip-stl-load.spec.ts e2e/vue.spec.ts --project=chromium",
    "test:e2e:raster-baseline": "playwright test e2e/raster-baseline-e2e.spec.ts --project=chromium",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "soak:laser": "vitest run src/core/laser/laserGolden.soak.spec.ts --config vitest.migration.ts",
    "soak:sla": "vitest run src/core/sla/slaGolden.soak.spec.ts --config vitest.migration.ts",
    "soak:hw-readiness": "vitest run src/core/migration/hwSoakReadiness.spec.ts --config vitest.migration.ts",
    "sync:kiri-sla-wasm": "node scripts/sync-kiri-sla-wasm.mjs",
    "soak:fdm:paint": "vitest run src/core/slicer/fdmSupportPaint.integration.spec.ts src/core/fdm/fdmPaintSoakMigration.spec.ts --config vitest.migration.ts",
    "build:kiri-sla-wasm": "node scripts/build-kiri-sla-wasm.mjs",
    "soak:laser:live": "vitest run src/core/laser/laserHwLive.live.spec.ts",
    "soak:sla:live": "vitest run src/core/sla/slaHwLive.live.spec.ts",
    "soak:sla:official": "vitest run src/core/sla/slaOfficialFormatValidate.spec.ts --config vitest.migration.ts",
    "soak:hw-signoff": "vitest run src/core/migration/hwFieldSignOff.spec.ts src/core/migration/hwSoakReadiness.spec.ts --config vitest.migration.ts"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "earcut": "^3.0.2",
    "element-plus": "^2.13.7",
    "manifold-3d": "^3.4.1",
    "pinia": "^3.0.4",
    "three": "^0.183.2",
    "three-mesh-bvh": "^0.9.9",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/eslint-plugin": "^1.6.13",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.57.0",
    "prettier": "3.8.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
